# Neon connection string for the Parts Engine database (its own database, not Ledger's)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Optional: live EbayDecisions market facts refresh and one-click research (MPNs → Research queue). Server-only.
# When either is blank, both buttons are hidden and CSV/XLSX market import stays the path.
EBAYDECISIONS_URL=https://ebay-decisions.vercel.app
# Same secret the provider accepts as its INTEGRATION_API_KEY. Never expose it to the browser.
EBAYDECISIONS_API_KEY=

# Neon connection string for the Parts Engine database (its own database, not Ledger's)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Optional: live EbayDecisions market facts refresh (MPNs → Research queue). Server-only.
# When either is blank, the refresh button is hidden and the shared research CSV / CSV/XLSX market import stays the path.
EBAYDECISIONS_URL=https://ebay-decisions.vercel.app
# Same secret the provider accepts as its INTEGRATION_API_KEY. Never expose it to the browser.
EBAYDECISIONS_API_KEY=

# Optional: tech-note card reader (Tech notes page). Server-only; never exposed to the browser.
# Without a key, photos are still kept and notes are typed by hand.
GEMINI_API_KEY=
# Owner model rule: OCR on gemini-3.1-flash-lite, "Re-read carefully" on gemini-3.5-flash. Override here if a model is retired.
GEMINI_OCR_MODEL=gemini-3.1-flash-lite
GEMINI_OCR_CAREFUL_MODEL=gemini-3.5-flash
# MINIMAL | LOW | MEDIUM | HIGH | OFF
GEMINI_OCR_THINKING_LEVEL=MEDIUM
